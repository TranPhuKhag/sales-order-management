projection;
strict ( 2 );
use draft;
use side effects;

define behavior for ZCR_TEAM2_SO_HD alias Header
use etag
{
  use create;
  use update;
  use delete;

  use action Activate;
  use action Discard;
  use action Edit;
  use action Resume;
  use action Prepare;

  use association _Item { create;  with draft; }
  use association _ScheduleLine { with draft; }
}


define behavior for ZC_TEAM2_SO_IT alias Item

use etag

{
  use update;
  use delete;

  use association _Header { with draft; }
  use association _ScheduleLine { create; with draft; }
}

define behavior for ZC_TEAM2_SCHED_LN alias ScheduleLine
use etag
{
  use update;
  use delete;

  use action confirmDelivery;

  use association _Item { with draft; }
  use association _Header { with draft; }
}