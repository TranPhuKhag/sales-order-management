
@Metadata.layer: #CORE

@UI.headerInfo: {
  typeName: 'Schedule Line',
  typeNamePlural: 'Schedule Lines',
  title: {
    type: #STANDARD,
    value: 'ScheduleLineId'
  }
}

annotate view ZC_TEAM2_SCHED_LN with
{
  // Object Page of the Schedule Line. Without facets the Fiori app has no
  // Schedule Line page: after "Create" the URL points to a page that is never
  // rendered, the router gets out of sync and "Apply" on the Item page hangs.
  @UI.facet: [
    {
      id: 'ScheduleLineGeneralInfo',
      label: 'Schedule Line Information',
      purpose: #STANDARD,
      position: 10,
      type: #IDENTIFICATION_REFERENCE
    }
  ]

  @UI.identification: [ { position: 10, label: 'Schedule Line' } ]
  @UI.lineItem: [
    {
      position: 10,
      label: 'Schedule Line'
    },
    {
      type: #FOR_ACTION,
      dataAction: 'confirmDelivery',
      label: 'Confirm Delivery',
      position: 80
    }
  ]
  ScheduleLineId;

  @UI.identification: [ { position: 20, label: 'Requested Delivery Date' } ]
  @UI.lineItem: [
    {
      position: 20,
      label: 'Requested Delivery Date'
    }
  ]
  RequestedDeliveryDate;

  @UI.identification: [ { position: 30, label: 'Requested Quantity' } ]
  @UI.lineItem: [
    {
      position: 30,
      label: 'Requested Quantity'
    }
  ]
  RequestedQuantity;

  @UI.identification: [ { position: 40, label: 'Confirmed Delivery Date' } ]
  @UI.lineItem: [
    {
      position: 40,
      label: 'Confirmed Delivery Date'
    }
  ]
  ConfirmedDeliveryDate;

  @UI.identification: [ { position: 50, label: 'Confirmed Quantity' } ]
  @UI.lineItem: [
    {
      position: 50,
      label: 'Confirmed Quantity'
    }
  ]
  ConfirmedQuantity;

@UI.hidden: true
  SalesUnit;

  @UI.identification: [ { position: 60, label: 'Availability Status', criticality: 'AvailabilityCriticality' } ]
  @UI.lineItem: [
    {
      position: 60,
      label: 'Availability Status',
      criticality: 'AvailabilityCriticality'
    }
  ]
  AvailabilityStatus;

  @UI.hidden: true
  AvailabilityCriticality;
}
