@Metadata.layer: #CORE
@UI.headerInfo.title.type: #STANDARD
@UI.headerInfo.title.value: 'SalesOrderId'
@UI.headerInfo.description.type: #STANDARD
@UI.headerInfo.description.value: 'SalesOrderId'
annotate view ZCR_TEAM2_SO_HD with
{
  @UI.facet: [
    {
      id: 'GeneralInfo',
      label: 'General Information',
      purpose: #STANDARD,
      position: 10,
      type: #IDENTIFICATION_REFERENCE
    },
    {
      id: 'SoldToInfo',
      label: 'Sold-to Customer Information',
      purpose: #STANDARD,
      position: 12,
      type: #FIELDGROUP_REFERENCE,
      targetQualifier: 'SoldToInfo'
    },
    {
      id: 'ShipToInfo',
      label: 'Ship-to Customer Information',
      purpose: #STANDARD,
      position: 14,
      type: #FIELDGROUP_REFERENCE,
      targetQualifier: 'ShipToInfo'
    },
    {
      id: 'SalesOrderItems',
      label: 'Sales Order Items',
      purpose: #STANDARD,
      position: 20,
      type: #LINEITEM_REFERENCE,
      targetElement: '_Item'
    }
  ]
  @EndUserText.label: 'Sales Order'
  @UI.identification: [
    { position: 10, label: 'Sales Order' },
    { type: #FOR_ACTION, dataAction: 'confirmOrder', label: 'Confirm Order', position: 200 },
    { type: #FOR_ACTION, dataAction: 'rejectOrder', label: 'Reject Order', position: 210 },
    { type: #FOR_ACTION, dataAction: 'completeOrder', label: 'Complete Order', position: 220 }
  ]
  @UI.lineItem: [{ position: 10, label: 'Sales Order' }]
  @UI.selectionField: [{ position: 10 }]
  SalesOrderId;

  @EndUserText.label: 'Sales Order Type'
  @UI.identification: [{ position: 20, label: 'Sales Order Type' }]
  @UI.lineItem: [{ position: 20, label: 'Sales Order Type' }]
  @UI.selectionField: [{ position: 20 }]
  SalesOrderType;

  //  @EndUserText.label: 'Sold-to Party'
  //  @UI.identification: [{ position: 30, label: 'Sold-to Party' }]
  //  @UI.lineItem: [{ position: 30, label: 'Sold-to Party' }]
  //  @UI.selectionField: [{ position: 30 }]
  //  SoldToPartyId;
  //
  //  @EndUserText.label: 'Ship-to Party'
  //  @UI.identification: [{ position: 40, label: 'Ship-to Party' }]
  //  @UI.lineItem: [{ position: 40, label: 'Ship-to Party' }]
  //  @UI.selectionField: [{ position: 40 }]
  //  ShipToPartyId;

  @EndUserText.label: 'Sales Organization'
  @UI.identification: [{ position: 50, label: 'Sales Organization' }]
  @UI.lineItem: [{ position: 50, label: 'Sales Organization' }]
  @UI.selectionField: [{ position: 50 }]
  SalesOrganization;

  @EndUserText.label: 'Distribution Channel'
  @UI.identification: [{ position: 60, label: 'Distribution Channel' }]
  @UI.lineItem: [{ position: 60, label: 'Distribution Channel' }]
  @UI.selectionField: [{ position: 60 }]
  DistributionChannel;

  @EndUserText.label: 'Division'
  @UI.identification: [{ position: 70, label: 'Division' }]
  @UI.lineItem: [{ position: 70, label: 'Division' }]
  @UI.selectionField: [{ position: 70 }]

  Division;

  @EndUserText.label: 'Sales Order Date'
  @UI.identification: [{ position: 80, label: 'Sales Order Date' }]
  @UI.lineItem: [{ position: 80, label: 'Sales Order Date' }]
  @UI.selectionField: [{ position: 80 }]
  SalesOrderDate;

  @EndUserText.label: 'Pricing Date'
  @UI.identification: [{ position: 90, label: 'Pricing Date' }]
  @UI.lineItem: [{ position: 90, label: 'Pricing Date' }]
  PricingDate;

  @EndUserText.label: 'Requested Delivery Date'
  @UI.identification: [{ position: 100, label: 'Requested Delivery Date' }]
  @UI.lineItem: [{ position: 100, label: 'Requested Delivery Date' }]
  RequestedDeliveryDate;

  @EndUserText.label: 'Net Amount'
  @UI.identification: [{ position: 110, label: 'Net Amount' }]
  @UI.lineItem: [{ position: 110, label: 'Net Amount' }]
  NetAmount;

  @EndUserText.label: 'Lifecycle Status'
  @UI.identification: [{ position: 120, label: 'Lifecycle Status', criticality: 'LifecycleStatusCriticality' }]
  @UI.lineItem: [{ position: 120, label: 'Lifecycle Status', criticality: 'LifecycleStatusCriticality' }]
  @UI.selectionField: [{ position: 120 }]
  LifecycleStatus;

  @EndUserText.label: 'Overall Status'
  @UI.identification: [{ position: 130, label: 'Overall Status', criticality: 'OverallStatusCriticality' }]
  @UI.lineItem: [{ position: 130, label: 'Overall Status', criticality: 'OverallStatusCriticality' }]
  @UI.selectionField: [{ position: 130 }]
  OverallStatus;

  @EndUserText.label: 'Rejection Reason'
  @UI.identification: [{ position: 140, label: 'Rejection Reason' }]
  Reason;

  @EndUserText.label: 'Created By'
  @UI.identification: [{ position: 150, label: 'Created By' }]
  @UI.lineItem: [{ position: 150, label: 'Created By' }]
  CreatedBy;

  @EndUserText.label: 'Created At'
  @UI.identification: [{ position: 160, label: 'Created At' }]
  CreatedAt;

  @EndUserText.label: 'Local Last Changed By'
  @UI.identification: [{ position: 170, label: 'Local Last Changed By' }]
  LocalLastChangedBy;

  @EndUserText.label: 'Local Last Changed At'
  @UI.identification: [{ position: 180, label: 'Local Last Changed At' }]
  LocalLastChangedAt;

  @EndUserText.label: 'Last Changed At'
  @UI.identification: [{ position: 190, label: 'Last Changed At' }]
  LastChangedAt;
  // Add to the existing SoldToPartyId annotation.
  @UI.fieldGroup: [{ qualifier: 'SoldToInfo', position: 10, label: 'Customer ID' }]
  SoldToPartyId;

  // Add to the existing ShipToPartyId annotation.
  @UI.fieldGroup: [{ qualifier: 'ShipToInfo', position: 10, label: 'Customer ID' }]
  ShipToPartyId;

  // Begin change: KHANGTP5 - 14/10/2026
  // Sold-to Customer details.
  @UI.fieldGroup: [{ qualifier: 'SoldToInfo', position: 20, label: 'Customer Name' }]
  SoldToPartyName;

  @UI.fieldGroup: [{ qualifier: 'SoldToInfo', position: 30, label: 'Street' }]
  SoldToPartyStreet;

  @UI.fieldGroup: [{ qualifier: 'SoldToInfo', position: 40, label: 'City' }]
  SoldToPartyCity;

  @UI.fieldGroup: [{ qualifier: 'SoldToInfo', position: 50, label: 'Country' }]
  SoldToPartyCountry;

  @UI.fieldGroup: [{ qualifier: 'SoldToInfo', position: 60, label: 'Phone' }]
  SoldToPartyPhone;

  @UI.fieldGroup: [{ qualifier: 'SoldToInfo', position: 70, label: 'Email' }]
  SoldToPartyEmail;

  // Ship-to Customer details.
  @UI.fieldGroup: [{ qualifier: 'ShipToInfo', position: 20, label: 'Customer Name' }]
  ShipToPartyName;

  @UI.fieldGroup: [{ qualifier: 'ShipToInfo', position: 30, label: 'Street' }]
  ShipToPartyStreet;

  @UI.fieldGroup: [{ qualifier: 'ShipToInfo', position: 40, label: 'City' }]
  ShipToPartyCity;

  @UI.fieldGroup: [{ qualifier: 'ShipToInfo', position: 50, label: 'Country' }]
  ShipToPartyCountry;

  @UI.fieldGroup: [{ qualifier: 'ShipToInfo', position: 60, label: 'Phone' }]
  ShipToPartyPhone;

  @UI.fieldGroup: [{ qualifier: 'ShipToInfo', position: 70, label: 'Email' }]
  ShipToPartyEmail;
  // End change: KHANGTP5 - 14/10/2026
}